# Токен вашего Telegram-бота, полученный от @BotFather (например: 123456789:ABCdefGhIJKlmNoPQRstuVWxyz)
BOT_TOKEN=

# URL адрес Mini App (в dev-режиме: http://localhost:5173, для реального Telegram: https://your-domain.ngrok-free.app)
WEBAPP_URL=http://localhost:5173

# База данных SQLite
DATABASE_URL=sqlite+aiosqlite:///./gym_tracker.db

# Режим разработки (True позволяет открывать в обычном браузере без проверки Telegram initData)
DEV_MODE=True
